{
  "name": "setup-cli",
  "version": "1.0.0",
  "description": "CLI tool for managing Windows applications via winget",
  "main": "dist/index.js",
  "bin": {
    "setup": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:exe": "npm run build && pkg dist/index.js --targets node18-win-x64 --output setup.exe && node add-manifest.js",
    "start": "node dist/index.js"
  },
  "keywords": [
    "winget",
    "cli",
    "windows",
    "package-manager"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "ink": "^7.0.2",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.6"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "pkg": "^5.8.1",
    "rcedit": "^5.0.2",
    "typescript": "^5.5.0"
  }
}
